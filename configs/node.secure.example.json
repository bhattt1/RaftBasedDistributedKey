{
  "node_id": "n1",
  "cluster_id": "example",
  "data_dir": "/var/lib/raftkv",

  "raft_listen": ":7000",
  "http_listen": ":8000",
  "admin_listen": "127.0.0.1:9000",

  "peers": [
    {"id": "n1", "raft_addr": "n1.example.internal:7000", "http_addr": "https://n1.example.internal:8000"},
    {"id": "n2", "raft_addr": "n2.example.internal:7000", "http_addr": "https://n2.example.internal:8000"},
    {"id": "n3", "raft_addr": "n3.example.internal:7000", "http_addr": "https://n3.example.internal:8000"}
  ],

  "tls": {
    "peer_ca": "/etc/raftkv/ca.pem",
    "peer_cert": "/etc/raftkv/n1.pem",
    "peer_key": "/etc/raftkv/n1.key",
    "http_cert": "/etc/raftkv/n1.pem",
    "http_key": "/etc/raftkv/n1.key",
    "client_token_file": "/etc/raftkv/client.token"
  }
}
